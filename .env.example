# Dev credentials — runtime values come from Infisical via scripts/with-secrets.sh,
# or from the process environment when SKIP_VAULT=1 (CI / grader).
# Host and port point to PgBouncer, not to Postgres directly.
DATABASE_URL=postgres://app:CHANGE_ME@127.0.0.1:5432/marketplace
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=app
DB_PASSWORD=CHANGE_ME
DB_NAME=marketplace
BROKER_URL=amqp://app:CHANGE_ME@127.0.0.1:5672
# Cache instance (allkeys-lru) and queue/state instance (noeviction): two processes on purpose.
REDIS_URL=redis://127.0.0.1:6390
REDIS_QUEUE_URL=redis://127.0.0.1:6391
# Signing key and refresh pepper come from the vault. PEM is base64 so it survives `export`.
JWT_KID=dev
JWT_PRIVATE_KEY=BASE64_PKCS8_PEM
JWT_PUBLIC_KEY=BASE64_SPKI_PEM
# Optional overlap set: {"previous-kid":"BASE64_SPKI_PEM"}
JWT_PUBLIC_KEYS=
REFRESH_TOKEN_PEPPER=CHANGE_ME
# Object storage. Empty endpoint = AWS S3. Keys come from the vault.
STORAGE_ENDPOINT=http://127.0.0.1:22650
STORAGE_REGION=us-east-1
STORAGE_BUCKET=hw26-files
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
# Local CDN edge (npm run edge)
EDGE_PORT=8088
# Express `trust proxy`: who may set X-Forwarded-For/-Proto. Default trusts private-network proxies only.
TRUST_PROXY=loopback, linklocal, uniquelocal
# Observability (HW-29). Addresses of the local collector / Prometheus / Grafana.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:22918
PROMETHEUS_URL=http://127.0.0.1:22901
TRACE_API_URL=http://127.0.0.1:22904
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME
# Scrape address Prometheus should use. Empty: host.docker.internal plus the port this process bound.
# METRICS_TARGET=
# METRICS_TARGET_HOST=host.docker.internal
# Demo routes (/demo/fail, /demo/flush). Set only by demo:metrics and demo:trace.
# DEMO_ROUTES=1
# HW-31. Values come from the vault through scripts/with-secrets.sh. No new env file.
# HW31_STATE_BUCKET is the private S3 Pulumi backend (SSE-S3, not tagged Project=nodejs-pro-hw31).
# HW31_BUDGET_EMAIL receives the $5 ACTUAL budget letter.
# HW31_DB_PASSWORD is stored in the demo stack config on up; CI destroy does not read it.
# HW31_STATE_BUCKET=
# HW31_BUDGET_EMAIL=
# HW31_DB_PASSWORD=
