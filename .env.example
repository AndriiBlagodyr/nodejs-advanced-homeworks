# Dev credentials — runtime values come from Infisical via scripts/with-secrets.sh,
# or from the process environment when SKIP_VAULT=1 (CI / grader).
# Host and port point to PgBouncer, not to Postgres directly.
DATABASE_URL=postgres://app:CHANGE_ME@127.0.0.1:5432/marketplace
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=app
DB_PASSWORD=CHANGE_ME
DB_NAME=marketplace
BROKER_URL=amqp://app:CHANGE_ME@127.0.0.1:5672
# Cache instance (allkeys-lru) and queue/state instance (noeviction): two processes on purpose.
REDIS_URL=redis://127.0.0.1:6390
REDIS_QUEUE_URL=redis://127.0.0.1:6391
# Express `trust proxy`: who may set X-Forwarded-For/-Proto. Default trusts private-network proxies only.
TRUST_PROXY=loopback, linklocal, uniquelocal
