    "test": "npm run lint:openapi && node --test"
  },
  "dependencies": {
    "express": "4.22.2",
    "express-openapi-validator": "5.6.2"
  },
  "devDependencies": {
    "@redocly/cli": "2.46.0"
  },
  "engines": {
    "node": ">=22"
  }
}
