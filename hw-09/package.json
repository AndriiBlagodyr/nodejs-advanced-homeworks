{
  "name": "marketplace-api-contract",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "lint:openapi": "redocly lint openapi/openapi.yaml",
