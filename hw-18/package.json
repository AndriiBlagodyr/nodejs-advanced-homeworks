{
  "name": "marketplace-orm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "bash scripts/with-secrets.sh dev node dist/src/main.js",
    "demo:realtime": "node scripts/realtime-demo.mjs",
    "migrate": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:run -d dist/src/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:show -d dist/src/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:revert -d dist/src/data-source.js",
    "seed": "bash scripts/with-secrets.sh dev node dist/src/seed.js",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/src/demo-nplus1.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/src/demo-race.js",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/src/demo-workers.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/src/demo-retry.js",
    "report": "bash scripts/with-secrets.sh dev node dist/src/report.js",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:contract": "jest --selectProjects contract",
    "verify:provider": "ts-node test/contract/provider.verify.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.2.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.5",
    "@pact-foundation/pact": "^17.1.4",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
