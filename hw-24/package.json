{
  "name": "marketplace-orm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "prestart": "tsc",
    "start": "node dist/src/main.js",
    "start:vault": "bash scripts/with-secrets.sh dev npm run start",
    "relay": "bash scripts/with-secrets.sh dev node dist/src/outbox/relay-main.js",
    "consumer": "bash scripts/with-secrets.sh dev node dist/src/outbox/consumer-main.js",
    "outbox:purge": "bash scripts/with-secrets.sh dev node dist/src/outbox/purge-main.js",
    "predemo:outbox": "tsc",
    "demo:outbox": "bash scripts/with-secrets.sh dev node dist/src/demos/demo-outbox.js",
    "predemo:crash-write": "tsc",
    "demo:crash-write": "bash scripts/with-secrets.sh dev node dist/src/demos/demo-crash-write.js",
    "predemo:crash-relay": "tsc",
    "demo:crash-relay": "bash scripts/with-secrets.sh dev node dist/src/demos/demo-crash-relay.js",
    "worker": "bash scripts/with-secrets.sh dev node dist/src/queue/worker-main.js",
    "predemo:cache": "tsc",
    "demo:cache": "bash scripts/with-secrets.sh dev node dist/src/demos/demo-cache.js",
    "predemo:session": "tsc",
    "demo:session": "bash scripts/with-secrets.sh dev node dist/src/demos/demo-session.js",
    "predemo:ratelimit": "tsc",
    "demo:ratelimit": "bash scripts/with-secrets.sh dev node dist/src/demos/demo-ratelimit.js",
    "predemo:queue": "tsc",
    "demo:queue": "bash scripts/with-secrets.sh dev node dist/src/demos/demo-queue.js",
    "predemo:auth": "tsc",
    "demo:auth": "bash scripts/with-secrets.sh dev node dist/src/demos/demo-auth.js",
    "predemo:reuse": "tsc",
    "demo:reuse": "bash scripts/with-secrets.sh dev node dist/src/demos/demo-reuse.js",
    "predemo:rbac": "tsc",
    "demo:rbac": "bash scripts/with-secrets.sh dev node dist/src/demos/demo-rbac.js",
    "migrate": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:run -d dist/src/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:show -d dist/src/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:revert -d dist/src/data-source.js",
    "seed": "bash scripts/with-secrets.sh dev node dist/src/seed.js",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/src/demo-nplus1.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/src/demo-race.js",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/src/demo-workers.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/src/demo-retry.js",
    "report": "bash scripts/with-secrets.sh dev node dist/src/report.js",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:contract": "jest --selectProjects contract",
    "verify:provider": "ts-node test/contract/provider.verify.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.2.6",
    "amqplib": "^2.2.0",
    "bullmq": "^6.3.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.5",
    "@pact-foundation/pact": "^17.1.4",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
